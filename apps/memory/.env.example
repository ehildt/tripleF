# ─────────────────────────────────────────────────────────────
# tripleF memory — required environment
#
# Sorted by controller: infra preamble first (boot-critical), then one
# section per controller in dependency order. Everything with a code
# fallback lives in the commented sections below. Runtime-tunable settings
# (memory overrides, encyclopedia knobs) are managed in SysCtl (dashboard)
# and persisted per session in the database — the envs here are their
# baselines, not the live values.
# ─────────────────────────────────────────────────────────────

# ─────────────────────────────
# App server
# PORT/BODY_LIMIT are required — boot validation fails without them
# ─────────────────────────────
PORT=3400
ADDRESS=0.0.0.0
NODE_ENV=local # 'development' | 'production' | 'test' | 'local'
BODY_LIMIT=104857600

# ─────────────────────────────
# Postgres
# ─────────────────────────────
POSTGRES_URL=postgres://triplef:triplef@postgres:5432/triplef?sslmode=disable

# ─────────────────────────────
# BullMQ (KeyDB/Redis) connection
# ─────────────────────────────
BULLMQ_HOST=keydb
BULLMQ_PORT=6379
BULLMQ_USER=default
BULLMQ_PASS=redis

# ─────────────────────────────
# Ollama (LLM) — use https://ollama.com/api for Ollama Cloud only
# ─────────────────────────────
OLLAMA_HOST=http://host.docker.internal:11434/api
# OLLAMA_API_KEY=

# ─────────────────────────────
# Secrets cipher
# Master key (hex, 32 bytes) for AES-256-GCM encryption of provider API keys
# persisted by SysCtl. Without it, API keys are kept in memory only.
# Generate: openssl rand -hex 32
# Rotation: move the old key to TRIPLEF_SECRETS_KEY_PREVIOUS and set the new
# key here — stored keys are re-encrypted on boot; remove the previous key
# afterwards.
# ─────────────────────────────
TRIPLEF_SECRETS_KEY=
# TRIPLEF_SECRETS_KEY_PREVIOUS=

# ─────────────────────────────
# Qdrant — memory read/write + constellation
# [QdrantController] /qdrant
# The vector store for the semantic memory feature. Feature is ON by default
# (MEMORY_ENABLED=true) — set false to run the harness without memory.
# ─────────────────────────────
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=qdrant-local-dev-key-change-me  # optional; if set, must match QDRANT__SERVICE__API_KEY in infra.compose.yml (auth is OFF for local dev)
QDRANT_COLLECTION=harness_memory    # base name; resolved collection = base + "_" + embed model slug
QDRANT_VECTOR_SIZE=768       # fallback embedding dims when the model probe fails at boot (derived from the live model otherwise)
QDRANT_EMBED_MODEL=nomic-embed-text-v2-moe  # embedding model for memory chunks (768-dim, 512-token ctx)
QDRANT_SCORE_THRESHOLD=0.5  # minimum cosine score for memory search hits
QDRANT_EMBED_TIMEOUT_MS=60000  # embed-call timeout; a hung Ollama becomes a transient failure that retries
MEMORY_ENABLED=true
# MEMORY_CONSTELLATION_NODE_LIMIT=5000  # max constellation dots loaded per space (clamped 100–10000)
# MEMORY_EPISODE_RECENCY_WEIGHT=0.3        # how much recency may break topical ties in the short-term conversation-memory ranking (0–1)
# MEMORY_EPISODE_RECENCY_SCALE_SECONDS=604800  # decay horizon in seconds — an episode this old loses half its recency bonus (60–31536000)
# MEMORY_EPISODE_RECENCY_MIDPOINT=0.5       # decay midpoint (0.01–0.99)
# MEMORY_EPISODE_PROBE_LIMIT=3              # max short-term conversation-memory records injected per turn (1–10)
# MEMORY_EPISODE_SCORE_THRESHOLD=0.1        # noise floor for the episode probe's recency prefetch (0–1)
# MEMORY_VECTORIZE_TEXT_RATIO=0.5           # share of numCtx reserved for the extract-step source text (0 = uncapped)
# MEMORY_VECTORIZE_TEXT_CHARS=0             # absolute fallback for the extract-step source cap when numCtx is absent (0 = uncapped)
# MEMORY_LINK_NEIGHBORS=3                   # max semantic neighbors per dot in the constellation link graph (1–10)
# MEMORY_LINK_SCORE_THRESHOLD=0.7           # minimum cosine score for a constellation link edge (0–1). nomic-embed floors unrelated texts at ~0.5–0.55, so 0.5 linked everything; 0.7 is where a link means relatedness — recompute existing scopes via POST /qdrant/memory/links/recompute after raising it
# MEMORY_LINK_TOPICAL_THRESHOLD=0.6         # minimum cosine score for a topical (suggested) link edge (0–1) — below the semantic bar but above the nomic anisotropy noise floor
# MEMORY_LINK_BACKFILL_MAX_POINTS=5000      # max points a lazy link-graph backfill processes in one pass (100–50000)
# MEMORY_LINK_READ_MAX=50000                # max edges returned per link-graph read (infra bound, score-desc)

# ─────────────────────────────
# Cognition — the AI's understanding of the user
# [MemoryCognitionMaintenanceController] /qdrant/memory/cognition
# The profile is write-driven (recomputed after every answered turn); the
# only manual sweep is ① reflect.
# ─────────────────────────────
# MEMORY_COGNITION_LIMIT=5000      # character cap for the AI cognition profile document (clamped 500–32000)
# MEMORY_PROFILE_PAYLOAD_RATIO=0.5          # share of numCtx reserved for the profile-job payload (0 = uncapped)
# MEMORY_PROFILE_PAYLOAD_CHARS=0            # absolute fallback for the profile payload cap when numCtx is absent (0 = uncapped)
# MEMORY_COGNITION_REFLECT_AUTO=false       # auto-trigger reflection after a cognition profile job

# ─────────────────────────────
# Partition maintenance — the fact pipeline, in dependency order
# [MemoryPartitionMaintenanceController] /qdrant/memory
# ① consolidate → ② relink → ③ reflect → ④ conviction → ⑤ cluster
# ─────────────────────────────
# ① Consolidate — dedupe/merge pending inserts (keep/redundant/merge)
# MEMORY_CONSOLIDATE_THRESHOLD=50  # pending inserts per partition that auto-trigger a memory consolidation sweep
# MEMORY_CONSOLIDATE_MODEL=        # chat model the consolidation sweep uses for merge verdicts (optional; the consolidate endpoint also accepts a model)
# ② Relink — collapse category variants + write topical edges (no dedicated envs; reuses MEMORY_CONSOLIDATE_MODEL)

# ③ Reflect — friction screen; the loser's facts are superseded
# MEMORY_REFLECT_MODEL=                     # chat model for the reflection pass's friction verdicts (optional; the reflect endpoint also accepts a model)
# MEMORY_REFLECT_BATCH_LIMIT=100            # max unreflected points screened per reflection run (1–500)
# MEMORY_REFLECT_MAX_CANDIDATES=5           # max near-neighbor candidates per point in the friction screen (1–100)
# MEMORY_PARTITION_REFLECT_AUTO=false       # auto-trigger reflection after a partition's consolidation sweep

# ④ Conviction synthesis — convictions (cognition lane) + bridges (partition lane)
# MEMORY_CONVICTION_MODEL=                  # chat model for the conviction-synthesis pass (optional; the conviction endpoint also accepts a model)
# MEMORY_CONVICTION_BATCH_LIMIT=100         # max evidence points offered per conviction-synthesis run (1–500)
# MEMORY_CONVICTION_MAX_PER_CLUSTER=5       # max convictions written per cluster per conviction-synthesis run (1–1000)
# MEMORY_CONVICTION_AUTO=false              # auto-trigger conviction synthesis after a partition's reflection sweep

# ⑤ Cluster detection — cluster the link graph + summarize each changed cluster
# MEMORY_CLUSTER_MODEL=                     # chat model for the cluster-summarization pass (optional; the cluster endpoint also accepts a model)
# MEMORY_CLUSTER_MIN_MEMBERS=2              # minimum members for a structural cluster (1–100)
# MEMORY_CLUSTER_AUTO=false                 # auto-trigger cluster detection after a lane's graph-mutating job

# ─────────────────────────────
# Knowledge encyclopedia (memory-encyclopedia collection)
# [EncyclopediaController + EncyclopediaMaintenanceController] /encyclopedia
# Read/select knobs first, then the maintenance pipeline
# (① consolidate → ② classify → ③ reflect → ④ cluster).
# ─────────────────────────────
# ENCYCLOPEDIA_COLLECTION=memory-encyclopedia         # base name; resolved collection = base + "_" + embed model slug
# ENCYCLOPEDIA_SELECT_ENABLED=true               # master switch for the select endpoint
# ENCYCLOPEDIA_BUDGET_CHARS=48000                # fallback selection budget in chars when the caller omits budgetChars
# ENCYCLOPEDIA_CHUNK_CHARS=1600                  # max chars per chunk (sentence-packed)
# ENCYCLOPEDIA_CHUNK_OVERLAP_SENTENCES=1         # sentence overlap between adjacent chunks
# ENCYCLOPEDIA_SCORE_THRESHOLD=0.25              # cosine floor; below it a chunk is noise
# ENCYCLOPEDIA_MAX_CHUNKS=400                    # safety bound on the embed batch
# ENCYCLOPEDIA_PERSIST_ENABLED=true              # false = ephemeral selection, nothing stored
# ENCYCLOPEDIA_PROBE_LIMIT=3                     # max global-probe passages returned per select
# ENCYCLOPEDIA_NEIGHBOR_EXPANSION=1              # chunks before/after a probe hit to include (0–3)
# ENCYCLOPEDIA_MAX_DOCUMENT_CHARS=4000000        # oversize ceiling; docs over it are rejected from the index (100000–16000000)
# ENCYCLOPEDIA_CONSOLIDATE_THRESHOLD=200         # pending-document threshold that auto-triggers the supersede sweep
# ENCYCLOPEDIA_CLASSIFY_MODEL=                   # chat model for the classification job (labels documents with category + topic; optional — the classify endpoint also accepts a model)
# ENCYCLOPEDIA_CLASSIFY_THRESHOLD=20             # pending-document threshold that auto-triggers the classification job
# MEMORY_ENCYCLOPEDIA_REFLECT_AUTO=false         # auto-trigger reflection after the encyclopedia classification job

# ─────────────────────────────
# Memory overrides
# [MemoryOverridesController] /memory-overrides
# Every MEMORY_*/ENCYCLOPEDIA_* model/limit/auto-trigger above is the env
# BASELINE. The live value is layered over it at runtime: SysCtl
# (settings → memory → configuration) writes overrides that take effect on
# the very next request without a restart. The embedding model
# (QDRANT_EMBED_MODEL) is deliberately NOT overridable — it owns the vector
# space and must never change mid-life.
# ─────────────────────────────

# ─────────────────────────────────────────────────────────────
# Optional global defaults (code fallbacks apply when unset;
# changing them requires a restart)
# ─────────────────────────────────────────────────────────────

# Base
# PRINT_CONFIG=true
# ENABLE_SWAGGER=true

# Logger
# LOGGER_LEVEL=info
# LOGGER_PRETTY=true
# LOGGER_BASE=                        # JSON object merged into every log line's base bindings (e.g. '{"service":"memory"}')
# LOGGER_TRANSPORT_TARGET=pino-pretty
# LOGGER_TRANSPORT_TRANSLATE_TIME=yyyy-mm-dd HH:MM:ss.l
# LOGGER_TRANSPORT_COLORIZE=true
# LOGGER_TRANSPORT_SINGLE_LINE=false
# LOGGER_TRANSPORT_COLORIZE_OBJECTS=true
# LOGGER_TRANSPORT_IGNORE=pid,hostname

# Health
# HEALTH_MEMORY_HEAP=512MB
# HEALTH_MEMORY_RSS=768MB
# HEALTH_DISK_PATH=/
# HEALTH_DISK_THRESHOLD=0.8

# Cors
# CORS_ORIGIN=*
# CORS_METHODS=GET,HEAD,OPTIONS,PUT,PATCH,POST,DELETE
# CORS_PREFLIGHT_CONTINUE=false
# CORS_OPTIONS_SUCCESS_STATUS=204
# CORS_CREDENTIALS=true
# CORS_ALLOWED_HEADERS=Content-Type,Accept,x-harness-llm

# BullMQ tuning
# BULLMQ_CONNECT_TIMEOUT=30000
# BULLMQ_COMMAND_TIMEOUT=30000
# BULLMQ_JOB_DELAY=0
# BULLMQ_JOB_LIFO=false
# BULLMQ_JOB_PRIORITY=0
# BULLMQ_JOB_ATTEMPTS=3
# BULLMQ_JOB_STACK_TRACE_LIMIT=3
# BULLMQ_VECTORIZE_CONCURRENCY=2
# BULLMQ_BACKOFF_TYPE=exponential
# BULLMQ_BACKOFF_DELAY=5270

# BullMQ TLS
# BULLMQ_USE_TLS=false
# BULLMQ_TLS_REJECT_UNAUTHORIZED=true
# BULLMQ_PASSPHRASE=test
# BULLMQ_TLS_CA=
# BULLMQ_TLS_CERT=
# BULLMQ_TLS_KEY=

# BullMQ Logger
# BULLMQ_LOG_LEVEL=info
# BULLMQ_LOG_PRETTY=true
# BULLMQ_LOG_BASE=
# BULLMQ_LOG_TIMESTAMP_ENABLED=true
# BULLMQ_LOG_TRANSPORT_TARGET=pino-pretty
# BULLMQ_LOG_TRANSPORT_TRANSLATE_TIME=yyyy-mm-dd HH:MM:ss.l
# BULLMQ_LOG_TRANSPORT_COLORIZE=true
# BULLMQ_LOG_TRANSPORT_IGNORE=pid,hostname

# Ollama request behavior
# OLLAMA_KEEP_ALIVE=15m
# OLLAMA_STREAM_CHUNK_TIMEOUT_MS=60000   # abort streaming if no chunk arrives for 60s
# OLLAMA_STREAM_TOTAL_TIMEOUT_MS=600000  # max total time for a streaming response (10m)
# OLLAMA_GENERATE_TOTAL_TIMEOUT_MS=300000  # max total time for non-streaming calls (5m)
# OLLAMA_ENABLE_SMOOTH_STREAM=true       # word-level smooth streaming; set false to disable
