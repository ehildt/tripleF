{
  "name": "@triplef/memory",
  "description": "tripleF (3F) memory app — the outsourced Qdrant/vector-memory service (NestJS + Fastify): semantic memory store, cognition profiles, and the BullMQ vectorize pipeline (embed/extract/store).",
  "version": "1.1.0",
  "license": "MIT",
  "type": "module",
  "author": {
    "email": "eugen.hildt@gmail.com",
    "name": "Eugen Hildt"
  },
  "bugs": {
    "email": "eugen.hildt@gmail.com"
  },
  "scripts": {
    "prebuild": "rimraf dist && dotenv -e ./.env.prisma -- prisma generate",
    "build": "nest build --path ./tsconfig.build.json",
    "build:prod": "nest build --path ./tsconfig.build.prod.json",
    "depcheck": "npx depcheck .",
    "depcruise": "npx dependency-cruiser -c .depcruise.mjs --ts-config tsconfig.json src",
    "lint": "eslint ./src",
    "lint-staged": "npx lint-staged --allow-empty",
    "ncu:update": "npx npm-check-updates -u --format group --dep prod,dev,optional,packageManager,peer",
    "ncu:interactive": "npx npm-check-updates -u --interactive --format group",
    "ncu:validate": "npx npm-check-updates -e 2 --packageFile=./package.json",
    "start": "nest start",
    "start:debug": "nest start --debug --watch  --preserveWatchOutput",
    "start:dev": "dotenv -e ./.env.prisma -- nest start --watch  --preserveWatchOutput",
    "db:generate": "dotenv -e ./.env.prisma -- prisma generate",
    "start:node": "node dist/main",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "lint:unused": "npx ts-unused-exports ./tsconfig.exclude.json --maxIssues=0"
  },
  "dependencies": {
    "@fastify/compress": "^9.2.1",
    "@fastify/static": "^10.1.6",
    "@nestjs/axios": "^12.0.1",
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/common": "^12.1.2",
    "@nestjs/core": "^12.1.2",
    "@nestjs/microservices": "^12.1.2",
    "@nestjs/platform-fastify": "^12.1.2",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/terminus": "^12.1.0",
    "@prisma/adapter-pg": "7",
    "@prisma/client": "7",
    "@qdrant/js-client-rest": "^1.19.0",
    "@triplef/agent": "^1.0.2",
    "@triplef/ai-sdk": "^0.1.5",
    "@triplef/bullmq": "^1.1.5",
    "@triplef/bullmq-logger": "^1.3.1",
    "@triplef/config-factory": "^1.2.1",
    "@triplef/core-logger": "^0.1.1",
    "@triplef/helpers": "^1.6.1",
    "@triplef/ollama-api": "^0.1.0",
    "ai": "^7.0.137",
    "bullmq": "^6.3.12",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "fastify": "^5.12.5",
    "ioredis": "^6.0.0",
    "joi": "^18.2.9",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^12.0.8",
    "@nestjs/schematics": "^12.0.6",
    "@swc/core": "^1.16.13",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.3",
    "depcheck": "^1.4.7",
    "dependency-cruiser": "^18.5.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-sonarjs": "^4.2.2",
    "globals": "^17.13.0",
    "jiti": "^2.7.0",
    "lint-staged": "^17.6.0",
    "npm-check-updates": "^23.1.0",
    "prisma": "^7.10.0",
    "rimraf": "^6.1.3",
    "ts-unused-exports": "^11.0.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "unplugin-swc": "^1.6.0",
    "vitest": "^5.0.3"
  }
}
