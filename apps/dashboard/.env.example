VITE_API_URL=
VITE_SOCKET_URL=http://localhost:3000
VITE_PROXY_TARGET=http://server:3000
# Memory app (direct, no server pass-through). Empty = same-origin via the
# /memory-api proxy; set an absolute URL for a cross-origin deployment.
VITE_MEMORY_API_URL=
VITE_MEMORY_PROXY_TARGET=http://memory:3400
