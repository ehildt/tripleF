# ─────────────────────────────────────────────────────────────
# tripleF server — required environment
#
# Sorted by module/controller: infra preamble first (boot-critical), then
# one section per module in dependency order. Everything with a code
# fallback lives in the commented sections below. Runtime-tunable settings
# (per-search-engine endpoints, image preprocessing, model sources) are
# managed in SysCtl (dashboard) and persisted per session in the database —
# the envs here are their pristine baselines, not the live values.
# ─────────────────────────────────────────────────────────────

# ─────────────────────────────
# App server
# PORT/BODY_LIMIT are required — boot validation fails without them
# ─────────────────────────────
PORT=3000
ADDRESS=0.0.0.0
NODE_ENV=local # 'development' | 'production' | 'test' | 'local'
BODY_LIMIT=104857600

# ─────────────────────────────
# Postgres
# [PersistenceModule] config/conversation/playlist controllers
# ─────────────────────────────
POSTGRES_URL=postgres://triplef:triplef@postgres:5432/triplef?sslmode=disable

# ─────────────────────────────
# BullMQ (KeyDB/Redis) connection
# [BullMQController] /bullmq
# ─────────────────────────────
BULLMQ_HOST=keydb
BULLMQ_PORT=6379
BULLMQ_USER=default
BULLMQ_PASS=redis

# ─────────────────────────────
# MinIO (required — boot validation fails without them)
# [StorageController] /storage
# ─────────────────────────────
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=failed-jobs
# MINIO_TTL_DAYS=7  # days an uploaded original is retained before expiry

# ─────────────────────────────
# Ollama (LLM) — use https://ollama.com/api for Ollama Cloud only
# [OllamaOverridesController] /ollama-overrides
# ─────────────────────────────
OLLAMA_HOST=http://host.docker.internal:11434/api
# OLLAMA_API_KEY=

# ─────────────────────────────
# Memory app (outsourced Qdrant/encyclopedia/cognition service)
# [MemoryClientService] — no controller; the harness's memory client
# Feature is ON by default (MEMORY_ENABLED=true) — set false to run the
# harness without memory.
# ─────────────────────────────
MEMORY_URL=http://memory:3400
MEMORY_ENABLED=true

# ─────────────────────────────
# Harness — the agentic pipeline
# [HarnessController] /harness
# ─────────────────────────────
# NUM_CTX=32768,65536,131072,262144,524288,1048576,2097152,4194304,5242880  # comma-separated context-size options offered to the model
# HARNESS_IMAGE_DOWNLOAD_TIMEOUT_MS=8000 # abort one cloud image download after 8s
# HARNESS_SOURCE_BUDGET_RATIO=0.125      # share of numCtx reserved for fetched-source selection
# HARNESS_SOURCE_BUDGET_CHARS=48000      # absolute fallback when numCtx is absent
# HARNESS_REFERENCE_DOC_RATIO=0.5        # per-doc ceiling share before chunk/embed
# HARNESS_REFERENCE_DOC_CHARS=100000     # absolute fallback for the per-doc ceiling
# HARNESS_GATHERED_TOTAL_RATIO=0.03      # memory-write gathered-block cap share
# HARNESS_GATHERED_TOTAL_CHARS=16000     # absolute fallback for the gathered-block cap

# ─────────────────────────────
# Provider overrides — search engines + source policy
# [ProviderOverridesController] /provider-overrides
# All engines are disabled by default and enabled per-engine in SysCtl;
# the keys/zones here are the pristine defaults SysCtl can override.
# ─────────────────────────────

# SysCtl Sources config — pristine defaults (SysCtl can override live)
# SOURCES_IMAGE_TASK_REFERENCE_COUNT=6  # web image candidates pooled for describe/compare/ocr (1-50)
# SOURCES_PREFERRED=                    # comma-separated hostnames/globs/regexes rank-boosted ahead of the long tail
# SOURCES_BLOCKED=                      # comma-separated hostnames/globs/regexes dropped from tool context entirely

# Serper (Google search)
SERPER_API_KEY=
# SERPER_ENABLED=false
# SERPER_WEB_ENABLED=true
# SERPER_WEB_RESULTS=10
# SERPER_IMAGES_ENABLED=true
# SERPER_IMAGES_RESULTS=10
# SERPER_NEWS_ENABLED=true
# SERPER_NEWS_RESULTS=10
# SERPER_PLACES_ENABLED=true
# SERPER_PLACES_RESULTS=10
# SERPER_SHOPPING_ENABLED=true
# SERPER_SHOPPING_RESULTS=10
# SERPER_REVIEWS_ENABLED=true
# SERPER_REVIEWS_RESULTS=10
# SERPER_VIDEOS_ENABLED=true
# SERPER_VIDEOS_RESULTS=10
# SERPER_SCRAPE_ENABLED=true

# Bright Data (alternative to Serper). SERP API and Web Unlocker share one
# endpoint and one API key, distinguished only by the zone name. Reviews are
# intentionally absent — Bright Data's reviews endpoint is broken upstream (502).
BRIGHT_DATA_API_KEY=
# BRIGHT_DATA_SERP_ZONE=
# BRIGHT_DATA_UNLOCKER_ZONE=
# BRIGHT_DATA_ENABLED=false
# BRIGHT_DATA_WEB_ENABLED=true
# BRIGHT_DATA_WEB_RESULTS=10
# BRIGHT_DATA_IMAGES_ENABLED=true
# BRIGHT_DATA_IMAGES_RESULTS=10
# BRIGHT_DATA_NEWS_ENABLED=true
# BRIGHT_DATA_NEWS_RESULTS=10
# BRIGHT_DATA_PLACES_ENABLED=true
# BRIGHT_DATA_PLACES_RESULTS=10
# BRIGHT_DATA_SHOPPING_ENABLED=true
# BRIGHT_DATA_SHOPPING_RESULTS=10
# BRIGHT_DATA_VIDEOS_ENABLED=true
# BRIGHT_DATA_VIDEOS_RESULTS=10
# BRIGHT_DATA_SCRAPE_ENABLED=true

# YouTube (official YouTube Data API)
# YOUTUBE_API_KEY=
# YOUTUBE_ENABLED=false
# YOUTUBE_VIDEOS_ENABLED=true
# YOUTUBE_VIDEOS_RESULTS=10

# EODHD (stock market data). Disabled by default; enable in SysCtl and set
# the key here as the pristine default SysCtl can override. Each endpoint
# has an enabled flag and a results knob (search/news limit, history points,
# technical period). Also consumed by the stock-data module.
EODHD_API_KEY=
# EODHD_ENABLED=false
# EODHD_SEARCH_ENABLED=true
# EODHD_SEARCH_RESULTS=10
# EODHD_QUOTE_ENABLED=true
# EODHD_QUOTE_RESULTS=1
# EODHD_HISTORY_ENABLED=true
# EODHD_HISTORY_RESULTS=250
# EODHD_TECHNICAL_ENABLED=true
# EODHD_TECHNICAL_RESULTS=14
# EODHD_INTRADAY_ENABLED=true
# EODHD_INTRADAY_RESULTS=30
# EODHD_NEWS_ENABLED=true
# EODHD_NEWS_RESULTS=10
# EODHD_NEWS_SNIPPET_CHARS=0            # cap on the news snippet text (0 = uncapped)
# EODHD_FUNDAMENTALS_ENABLED=true
# EODHD_FUNDAMENTALS_RESULTS=1

# ─────────────────────────────
# Image preprocessing (sharp)
# [SharpOverridesController] /sharp-overrides
# Pristine defaults — SysCtl can override live.
# ─────────────────────────────
# PPROC_ENABLED=true
# PPROC_RESIZE_MAX_WIDTH=768
# PPROC_RESIZE_MAX_HEIGHT=               # null = keep aspect ratio
# PPROC_RESIZE_WITHOUT_ENLARGEMENT=true
# PPROC_VARIANT_ORIGINAL=true
# PPROC_VARIANT_GRAYSCALE=false
# PPROC_VARIANT_DENOISED=false
# PPROC_VARIANT_SHARPENED=false
# PPROC_VARIANT_CLAHE=false
# PPROC_BLUR_SIGMA=0.5
# PPROC_SHARPEN_SIGMA=1
# PPROC_SHARPEN_M1=1
# PPROC_SHARPEN_M2=2
# PPROC_CONTRAST_LEVEL=1.3
# PPROC_BRIGHTNESS_LEVEL=1.2
# PPROC_CLAHE_WIDTH=8
# PPROC_CLAHE_HEIGHT=8
# PPROC_CLAHE_MAX_SLOPE=3
# PPROC_NORMALIZE_LOWER=1
# PPROC_NORMALIZE_UPPER=99

# ─────────────────────────────
# Dead letter queue
# [DeadLetterController] /dead-letter
# ─────────────────────────────
# DLQ_FAILED_RETAIN=100          # max failed rows retained per stage
# DLQ_FAILED_AGE_MS=604800000    # failed rows older than this are pruned (7d)
# DLQ_CLEARED_RETAIN=100         # max cleared rows retained per stage
# DLQ_CLEARED_AGE_MS=2592000000  # cleared rows older than this are pruned (30d)
# DLQ_REMOVED_RETAIN=0           # max removed rows retained per stage
# DLQ_REMOVED_AGE_MS=86400000    # removed rows older than this are pruned (1d)
# FAILED_JOB_RETRY_DELAY_MS=300000       # delay before a reinstated failed job retries (5m)
# FAILED_JOB_REINSTATE_BATCH_SIZE=10     # max failed jobs reinstated per batch

# ─────────────────────────────
# Socket.IO (realtime events)
# [SocketIoModule] — no controller; the gateway
# ─────────────────────────────
# SOCKET_IO_CONNECT_TIMEOUT=45000
# SOCKET_IO_MAX_HTTP_BUFFER_SIZE=262144
# SOCKET_IO_CLEANUP_EMPTY_CHILD_NAMESPACES=false
# SOCKET_IO_TRANSPORTS=websocket,polling,webtransport
# SOCKET_IO_CORS_ORIGIN=*
# SOCKET_IO_CORS_CREDENTIALS=true
# SOCKET_IO_CORS_METHODS=GET,POST
# SOCKET_IO_PING_INTERVAL=25000
# SOCKET_IO_PING_TIMEOUT=5000
# SOCKET_IO_ALLOW_EIO3=true

# ─────────────────────────────
# Playwright MCP browser-tools sidecar (compose service playwright-mcp)
# [PlaywrightMcpModule] — no controller; the sidecar client
# ─────────────────────────────
# PLAYWRIGHT_MCP_ENABLED=false
# PLAYWRIGHT_MCP_URL=http://playwright-mcp:8931/mcp
# PLAYWRIGHT_MCP_TOOLS=                 # comma-separated tool names to expose (empty = all)

# ─────────────────────────────
# Secrets cipher
# Master key (hex, 32 bytes) for AES-256-GCM encryption of provider API keys
# persisted by SysCtl. Without it, API keys are kept in memory only.
# Generate: openssl rand -hex 32
# Rotation: move the old key to TRIPLEF_SECRETS_KEY_PREVIOUS and set the new
# key here — stored keys are re-encrypted on boot; remove the previous key
# afterwards.
# ─────────────────────────────
TRIPLEF_SECRETS_KEY=
# TRIPLEF_SECRETS_KEY_PREVIOUS=

# ─────────────────────────────────────────────────────────────
# Optional global defaults (code fallbacks apply when unset;
# changing them requires a restart)
# ─────────────────────────────────────────────────────────────

# Base
# PRINT_CONFIG=true
# ENABLE_SWAGGER=true

# Logger
# LOGGER_LEVEL=info
# LOGGER_PRETTY=true
# LOGGER_BASE=                        # JSON object merged into every log line's base bindings (e.g. '{"service":"server"}')
# LOGGER_TRANSPORT_TARGET=pino-pretty
# LOGGER_TRANSPORT_TRANSLATE_TIME=yyyy-mm-dd HH:MM:ss.l
# LOGGER_TRANSPORT_COLORIZE=true
# LOGGER_TRANSPORT_SINGLE_LINE=false
# LOGGER_TRANSPORT_COLORIZE_OBJECTS=true
# LOGGER_TRANSPORT_IGNORE=pid,hostname

# Health
# HEALTH_MEMORY_HEAP=512MB
# HEALTH_MEMORY_RSS=768MB
# HEALTH_DISK_PATH=/
# HEALTH_DISK_THRESHOLD=0.8

# Cors
# CORS_ORIGIN=*
# CORS_METHODS=GET,HEAD,OPTIONS,PUT,PATCH,POST,DELETE
# CORS_PREFLIGHT_CONTINUE=false
# CORS_OPTIONS_SUCCESS_STATUS=204
# CORS_CREDENTIALS=true
# CORS_ALLOWED_HEADERS=Content-Type,Accept,x-harness-llm

# BullMQ tuning
# BULLMQ_CONNECT_TIMEOUT=30000
# BULLMQ_COMMAND_TIMEOUT=30000
# BULLMQ_JOB_DELAY=0
# BULLMQ_JOB_LIFO=false
# BULLMQ_JOB_PRIORITY=0
# BULLMQ_JOB_ATTEMPTS=3
# BULLMQ_JOB_STACK_TRACE_LIMIT=3
# BULLMQ_WORKER_CONCURRENCY=3
# BULLMQ_BACKOFF_TYPE=exponential
# BULLMQ_BACKOFF_DELAY=5270

# BullMQ TLS
# BULLMQ_USE_TLS=false
# BULLMQ_TLS_REJECT_UNAUTHORIZED=true
# BULLMQ_PASSPHRASE=test
# BULLMQ_TLS_CA=
# BULLMQ_TLS_CERT=
# BULLMQ_TLS_KEY=

# BullMQ Logger
# BULLMQ_LOG_LEVEL=info
# BULLMQ_LOG_PRETTY=true
# BULLMQ_LOG_BASE=
# BULLMQ_LOG_TIMESTAMP_ENABLED=true
# BULLMQ_LOG_TRANSPORT_TARGET=pino-pretty
# BULLMQ_LOG_TRANSPORT_TRANSLATE_TIME=yyyy-mm-dd HH:MM:ss.l
# BULLMQ_LOG_TRANSPORT_COLORIZE=true
# BULLMQ_LOG_TRANSPORT_IGNORE=pid,hostname

# Ollama request behavior
# OLLAMA_KEEP_ALIVE=15m
# OLLAMA_STREAM_CHUNK_TIMEOUT_MS=60000   # abort streaming if no chunk arrives for 60s
# OLLAMA_STREAM_TOTAL_TIMEOUT_MS=600000  # max total time for a streaming response (10m)
# OLLAMA_GENERATE_TOTAL_TIMEOUT_MS=300000  # max total time for non-streaming calls (5m)
# OLLAMA_ENABLE_SMOOTH_STREAM=true       # word-level smooth streaming; set false to disable
