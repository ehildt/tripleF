{
  "name": "@triplef/server",
  "description": "tripleF (3F) server — the agentic AI conversation harness (NestJS + Fastify): step engine, tool-grounded structured outputs, BullMQ, Socket.IO streaming.",
  "version": "1.4.0",
  "license": "MIT",
  "type": "module",
  "author": {
    "email": "eugen.hildt@gmail.com",
    "name": "Eugen Hildt"
  },
  "bugs": {
    "email": "eugen.hildt@gmail.com"
  },
  "scripts": {
    "prebuild": "rimraf dist && dotenv -e ./.env.prisma -- prisma generate",
    "build": "nest build --path ./tsconfig.build.json",
    "build:prod": "nest build --path ./tsconfig.build.prod.json",
    "depcheck": "npx depcheck .",
    "depcruise": "npx dependency-cruiser -c .depcruise.mjs --ts-config tsconfig.json src",
    "lint": "eslint ./src",
    "lint-staged": "npx lint-staged --allow-empty",
    "ncu:update": "npx npm-check-updates -u --format group",
    "ncu:interactive": "npx npm-check-updates -u --interactive --format group",
    "ncu:validate": "npx npm-check-updates -e 2 --packageFile=./package.json",
    "start": "nest start",
    "start:debug": "nest start --debug --watch  --preserveWatchOutput",
    "start:dev": "dotenv -e ./.env.prisma -- nest start --watch  --preserveWatchOutput",
    "db:generate": "dotenv -e ./.env.prisma -- prisma generate",
    "db:push": "dotenv -e ./.env.prisma -- prisma db push",
    "db:migrate": "dotenv -e ./.env.prisma -- prisma migrate dev",
    "db:migrate:prod": "dotenv -e ./.env.prisma -- prisma migrate deploy",
    "db:studio": "dotenv -e ./.env.prisma -- prisma studio",
    "start:node": "node dist/main",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "lint:unused": "npx ts-unused-exports ./tsconfig.exclude.json --maxIssues=0"
  },
  "dependencies": {
    "@ai-sdk/mcp": "^2.0.36",
    "@triplef/helpers": "^1.5.2",
    "@ehildt/nestjs-bullmq": "^1.1.3",
    "@ehildt/nestjs-bullmq-logger": "^1.2.4",
    "@triplef/config-factory": "^1.1.3",
    "@ehildt/nestjs-socket.io": "^1.3.3",
    "@fastify/compress": "^9.2.0",
    "@fastify/multipart": "^10.1.1",
    "@fastify/static": "^10.1.3",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/bullmq": "^11.0.5",
    "@nestjs/common": "^11.2.1",
    "@nestjs/core": "^11.2.1",
    "@nestjs/microservices": "^11.2.1",
    "@nestjs/platform-fastify": "^11.2.1",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/terminus": "^11.1.1",
    "@prisma/adapter-pg": "7",
    "@prisma/client": "7",
    "ai": "^7.0.77",
    "bullmq": "^6.2.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cld3-asm": "^4.0.0",
    "fastify": "^5.12.1",
    "ioredis": "^6.0.0",
    "joi": "^18.2.5",
    "json5": "^2.2.3",
    "minio": "^8.0.7",
    "ollama-ai-provider-v2": "^4.0.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.1",
    "@swc/core": "^1.16.1",
    "@types/node": "^26.2.0",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^4.1.11",
    "@vue/eslint-config-typescript": "^14.9.0",
    "depcheck": "^1.4.7",
    "dependency-cruiser": "^18.2.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^10.9.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-sonarjs": "^4.2.0",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "lint-staged": "^17.3.0",
    "npm-check-updates": "^23.1.0",
    "prisma": "^7.9.1",
    "rimraf": "^6.1.3",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "ts-unused-exports": "^11.0.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "unplugin-swc": "^1.5.11",
    "vitest": "^4.1.11"
  }
}
