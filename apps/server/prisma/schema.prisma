generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum DlqStatus {
  Failed
  Active
  Cleared
  Removed
}

model DeadLetterJob {
  id             String    @id @default(uuid())
  queueName      String    @db.VarChar(100)
  jobId          String    @db.VarChar(255)
  /** BullMQ job name — the logical identity (harness jobs: the request id). */
  jobName        String    @db.VarChar(255)
  status         DlqStatus @default(Failed)
  payload        Json      @default(dbgenerated())
  retryConfig    Json?
  failedReason   String?
  failedAt       DateTime?
  attemptsMade   Int       @default(1)
  totalAttempts  Int       @default(1)
  failureHistory Json?
  nextRetryAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now()) @updatedAt

  // The technical job identity; reinstate refreshes jobId in place so one
  // logical job keeps a single record across reinstate cycles.
  @@unique([queueName, jobId])
  @@index([jobName])
  @@map("dead_letter_job")
}

model HarnessConversation {
  sessionId      String   @db.VarChar(255)
  conversationId String   @db.VarChar(255)
  requestId      String   @db.VarChar(255)
  title          String?  @db.VarChar(500)
  content        Json     @default(dbgenerated())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt

  @@id([sessionId, conversationId, requestId])
  @@index([sessionId, conversationId])
  @@map("harness_conversation")
}

model HarnessConfig {
  sessionId         String   @id @db.VarChar(255)
  selectedModel     String?  @db.VarChar(255)
  preprocessing     Json?
  providerOverrides Json?
  memoryPartition   String?  @db.VarChar(255)
  memoryCognition   String?  @db.VarChar(255)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now()) @updatedAt

  @@map("harness_config")
}

enum ShownMediaKind {
  Image
  Video
}

/**
 * Media the user has already been shown inside a conversation, keyed by
 * deterministic identity: image entries carry the normalized content
 * fingerprint (fp:) or storage hash (sh:), video entries carry the canonical
 * provider keys produced by videoUrlKeys. Written at respond time from the
 * guarded final data; read at sanitize time so media-list follow-ups never
 * repeat already-shown content. Rows are purged when their conversation or
 * session is deleted.
 */
model HarnessShownMedia {
  sessionId      String         @db.VarChar(255)
  conversationId String         @db.VarChar(255)
  kind           ShownMediaKind
  mediaKey       String         @db.VarChar(255)
  requestId      String?        @db.VarChar(255)
  createdAt      DateTime       @default(now())

  @@id([sessionId, conversationId, kind, mediaKey])
  @@index([sessionId, conversationId])
  @@map("harness_shown_media")
}

model HarnessProviderOverride {
  provider  String   @id @db.VarChar(100)
  values    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@map("harness_provider_override")
}

/**
 * A named playlist scoped to one conversation. Videos are stored as a Json
 * array of VideoGalleryItem and belong to the playlist (the active playlist
 * is the queue). The compound key is (sessionId, conversationId, name), so
 * playlist names are unique per conversation. Rows are purged when their
 * conversation is deleted.
 */
model HarnessPlaylist {
  sessionId      String   @db.VarChar(255)
  conversationId String   @db.VarChar(255)
  name           String   @db.VarChar(255)
  videos         Json     @default(dbgenerated())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt

  @@id([sessionId, conversationId, name])
  @@index([sessionId, conversationId])
  @@map("harness_playlist")
}

/**
 * The AI's structured cognition profile of one person (the memory_cognition
 * lane): a single living JSON document of derived understanding (identity,
 * likes, goals, communication style). One row per cognition key; updates are
 * MERGED in code (mergeCognitionProfiles) and the row is atomically upserted
 * — never whole-document replaced from a model verdict. The document is the
 * routing map: its values are short topic strings that path-match the
 * insight vectors in Qdrant (path payload like `likes.cars`). Provenance
 * columns trace the last harness turn that updated the document.
 */
model MemoryCognitionProfile {
  space              String   @id @db.VarChar(255)
  profile            Json
  lastSessionId      String?  @db.VarChar(255)
  lastConversationId String?  @db.VarChar(255)
  lastRequestId      String?  @db.VarChar(255)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @default(now()) @updatedAt

  @@map("memory_cognition_profile")
}

/**
 * Cached end-of-day OHLCV bar for one ticker and trading date. Final bars
 * are immutable; the repository refetches the most recent days so late
 * updates (post-close uploads, restated adjusted closes) propagate.
 */
model StockMarketBar {
  ticker        String   @db.VarChar(64)
  date          DateTime @db.Date
  open          Float
  high          Float
  low           Float
  close         Float
  adjustedClose Float?
  volume        BigInt
  fetchedAt     DateTime @default(now())

  @@id([ticker, date])
  @@map("stock_market_bar")
}

/**
 * Ledger of the [from, to) date windows already fetched per ticker. Trading
 * days skip weekends/holidays, so coverage cannot be derived from the bars
 * alone — requests only backfill intervals not in this ledger.
 */
model StockMarketHistoryRange {
  ticker    String   @db.VarChar(64)
  fromDate  DateTime @db.Date
  toDate    DateTime @db.Date
  fetchedAt DateTime @default(now())

  @@id([ticker, fromDate, toDate])
  @@map("stock_market_history_range")
}

/**
 * Write ledger of the user's fact space (memory_partition lane in Qdrant): one
 * row per stored fact record, written by the vectorize store step and the
 * memoryRemember sync path. Powers the incremental consolidation sweep
 * (sweptAt null = pending) and doubles as the write-side audit trail — the
 * text snapshot survives even when a sweep later merges or deletes the point.
 */
model MemoryInsertLedger {
  id              String    @id @default(uuid())
  memoryPartition String    @db.VarChar(255)
  /** The Qdrant point id this row tracks (deterministic id from the store path). */
  pointId         String    @db.VarChar(64)
  role            String    @db.VarChar(16)
  /** Snapshot of the stored record text — the sweep's adjudication input. */
  text            String
  /** Harness turn id that wrote the record, when initiated by a turn. */
  requestId       String?   @db.VarChar(255)
  createdAt       DateTime  @default(now())
  /** null = pending consolidation; set once the sweep processed this insert. */
  sweptAt         DateTime?

  @@index([memoryPartition, sweptAt])
  @@map("memory_insert_ledger")
}

/**
 * Write ledger of the shared knowledge encyclopedia (memory-encyclopedia collection in
 * Qdrant): one row per stored DOCUMENT (url + content hash), written by the
 * encyclopedia select-persist path. Powers the deterministic supersede sweep
 * (sweptAt null = pending) — the sweep heals orphaned old-hash chunks left by
 * a crashed supersede, never adjudicates content. The encyclopedia is global
 * (public web content), so rows are not partition-scoped; partitionScope is
 * provenance only.
 */
model MemoryEncyclopediaInsertLedger {
  id             String    @id @default(uuid())
  url            String    @db.VarChar(2048)
  /** Hash of the full cleaned document content — the supersede identity. */
  contentHash    String    @db.VarChar(64)
  /** Number of chunk points this document version stored. */
  chunkCount     Int
  /** Partition that fetched the content — provenance, not a scope filter. */
  partitionScope String    @db.VarChar(255)
  title          String?   @db.VarChar(500)
  requestId      String?   @db.VarChar(255)
  createdAt      DateTime  @default(now())
  /** null = pending consolidation; set once the sweep processed this insert. */
  sweptAt        DateTime?
  /** null = pending classification; set once the classify job labeled the document. */
  classifiedAt   DateTime?

  @@index([sweptAt])
  @@index([classifiedAt])
  @@map("memory_encyclopedia_insert_ledger")
}

/**
 * Precomputed semantic link graph for the memory constellation: one row per
 * undirected edge between two Qdrant points whose cosine similarity cleared
 * the link threshold at store time. Written incrementally by the store paths
 * (each new point links to its top-k nearest neighbors) and cascaded on
 * delete, so the dashboard reads a ready graph with zero Qdrant round-trips.
 *
 * `lane` + `collection` + `scopeKey` scope the graph: partition facts and
 * cognition insights live in the memory collection (scope = the space key),
 * encyclopedia chunks in the encyclopedia collection (scope = 'global'). `collection`
 * is the model-namespaced name, so switching the embed model strands the old
 * graph harmlessly and the new collection backfills on first read.
 */
model MemoryLink {
  id         String   @id @default(uuid())
  /** 'partition' | 'cognition' | 'encyclopedia' */
  lane       String   @db.VarChar(16)
  /** Model-namespaced Qdrant collection name the points live in. */
  collection String   @db.VarChar(128)
  /** Space key: partition key / cognition key / 'global' (encyclopedia). */
  scopeKey   String   @db.VarChar(255)
  /** Lexicographically smaller point id (canonical undirected ordering). */
  source     String   @db.VarChar(64)
  /** Lexicographically larger point id. */
  target     String   @db.VarChar(64)
  /** Cosine similarity at edge-creation time. */
  score      Float
  /**
   * Edge kind: 'semantic' = enforced kNN link (store paths); 'topical' =
   * suggested link (relink job — recall ignores it, the dashboard may render
   * it faintly); 'evidence' = a bridge record's citation edge to a fact it
   * synthesizes (conviction store path — exact, not similarity-derived). One
   * edge per pair: semantic wins when both would apply.
   */
  kind       String   @default("semantic") @db.VarChar(16)
  createdAt  DateTime @default(now())

  @@unique([lane, collection, scopeKey, source, target])
  @@index([lane, collection, scopeKey])
  @@map("memory_link")
}

/**
 * Friction records of the memory constellation: one row per contradiction or
 * conflict between two Qdrant points, written by the reflection pass (Phase
 * 2). A friction is a state-machined pair — open until resolved or dismissed
 * — and the losing point is marked superseded on resolution (never deleted).
 * Scoped like MemoryLink: `lane` + `collection` + `scopeKey` identify the
 * space; `source`/`target` are the two conflicting point ids in canonical
 * undirected order.
 */
model MemoryFriction {
  id         String   @id @default(uuid())
  /** 'partition' | 'cognition' | 'encyclopedia' */
  lane       String   @db.VarChar(16)
  /** Model-namespaced Qdrant collection name the points live in. */
  collection String   @db.VarChar(128)
  /** Space key: partition key / cognition key / 'global' (encyclopedia). */
  scopeKey   String   @db.VarChar(255)
  /** Lexicographically smaller point id (canonical undirected ordering). */
  source     String   @db.VarChar(64)
  /** Lexicographically larger point id. */
  target     String   @db.VarChar(64)
  /**
   * Friction kind: 'contradiction' | 'superseded' | 'outdated' |
   * 'disagreement' — the reflection pass classifies the conflict.
   */
  kind       String   @db.VarChar(16)
  /** 'open' | 'resolved' | 'dismissed' — the friction's lifecycle state. */
  status     String   @default("open") @db.VarChar(16)
  /** LLM-written description of the conflict. */
  reason     String?  @db.VarChar(2000)
  /** How the friction was resolved (which point won, why). */
  resolution String?  @db.VarChar(2000)
  createdAt  DateTime @default(now())
  resolvedAt DateTime?

  @@unique([lane, collection, scopeKey, source, target])
  @@index([lane, collection, scopeKey])
  @@map("memory_friction")
}

/**
 * Detected clusters of the memory constellation: one row per cluster of
 * related Qdrant points, discovered by the memory-cluster job over the
 * link graph (semantic + topical + evidence edges) and summarized by an LLM
 * into a title + summary. The summary is the cluster's "report" — the
 * connective tissue that lets retrieval answer cross-cutting questions
 * without reading every member.
 *
 * Scoped like MemoryLink: `lane` + `collection` + `scopeKey` identify the
 * space. `fingerprint` is the hash of the sorted member ids — the drift
 * signal: a cluster whose membership changed gets a new fingerprint (and
 * id) and is re-summarized; unchanged clusters keep their row. The job
 * replaces a scope's rows atomically, so stale fingerprints never linger.
 */
model MemoryCluster {
  id          String   @id @db.VarChar(64)
  /** 'partition' | 'cognition' | 'encyclopedia' */
  lane        String   @db.VarChar(16)
  /** Model-namespaced Qdrant collection name the points live in. */
  collection  String   @db.VarChar(128)
  /** Space key: partition key / cognition key / 'global' (encyclopedia). */
  scopeKey    String   @db.VarChar(255)
  /** Hash of the sorted member ids — the membership-drift signal. */
  fingerprint String   @db.VarChar(64)
  /** LLM-written short noun-phrase label (2–6 words). */
  title       String   @db.VarChar(200)
  /** LLM-written one/two-sentence summary of the cluster. */
  summary     String   @db.VarChar(2000)
  /** Number of member points (denormalized for the dashboard). */
  memberCount Int
  /** The member point ids (authoritative membership list). */
  memberIds   String[]
  /** Hierarchy level: 0 = leaf cluster over points; 1+ = cluster of cluster synopses. */
  level       Int      @default(0)
  /** Parent cluster id at level+1 (null on the top level). */
  parentId    String?  @db.VarChar(64)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  @@unique([lane, collection, scopeKey, fingerprint])
  @@index([lane, collection, scopeKey])
  @@index([lane, collection, scopeKey, level])
  @@map("memory_cluster")
}

/**
 * Canonical macro-taxonomy of the memory constellation: one row per
 * user-visible label tier — `cluster` (plural family, e.g. `games`),
 * `community` (plural sub-family, e.g. `survival`), `hub` (singular entity,
 * e.g. `project zomboid`), `tag` (flat recall vocabulary). Scope =
 * (lane, scopeKey): partition facts per partition key, encyclopedia labels
 * under 'global'; the cognition lane is path-routed and taxonomy-free.
 *
 * The registry is the AI's read-only pick-list and the user's rename/merge
 * surface: persisted rows are never model-rewritten, only adopted (the probe
 * tool picks an id, or mints a new row via CREATE_NEW). Deliberately NOT
 * collection-namespaced — the taxonomy survives embed-model switches; label
 * embeddings for semantic probing live in Qdrant (a small model-namespaced
 * taxonomy collection, one point per node id) and are re-embedded lazily
 * when the embedder changes. `parentId` holds the id of the node one tier
 * up (community → cluster; hub → community, or cluster when no community
 * applies; '' for cluster roots and flat tags) so one unique key serves
 * every kind.
 */
model MemoryTaxonomyNode {
  id             String   @id @default(uuid())
  /** 'partition' | 'encyclopedia' (cognition is path-routed, taxonomy-free). */
  lane           String   @db.VarChar(16)
  /** Space key: partition key / 'global' (encyclopedia). */
  scopeKey       String   @db.VarChar(255)
  /** 'cluster' | 'community' | 'hub' | 'tag'. */
  kind           String   @db.VarChar(16)
  /** Id of the node one tier up; '' for cluster roots and flat tags. */
  parentId       String   @default("") @db.VarChar(64)
  /** Canonical display label as adopted at creation. */
  name           String   @db.VarChar(120)
  /** Normalized lookup form (trim/lowercase/folded) — uniqueness + snapping. */
  normalizedName String   @db.VarChar(120)
  /** Lucide allowlist icon name (macro-nodes; model-suggested on create, user-overridable). */
  icon           String?  @db.VarChar(64)
  /** Concise semantic summary of what belongs under this label. */
  summary        String?  @db.VarChar(2000)
  /** 'model' | 'user' — who minted the label. */
  createdBy      String   @default("model") @db.VarChar(16)
  /** Last reflection pass that touched points under this label. */
  lastReflectedAt  DateTime?
  /** Last consolidation pass that touched points under this label. */
  lastConsolidatedAt DateTime?
  /** Last relink pass that touched points under this label. */
  lastRelinkedAt   DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now()) @updatedAt

  aliases MemoryTaxonomyAlias[]

  @@unique([lane, scopeKey, kind, parentId, normalizedName])
  @@index([lane, scopeKey, kind, parentId])
  @@map("memory_taxonomy_node")
}

/**
 * Alias registry for taxonomy labels: every snapped/renamed/merged variant
 * stays recorded forever, so a killed label can never be re-minted by the
 * model and every server-side rewrite stays auditable. Scope columns are
 * denormalized from the node so one unique key covers the lookup shape.
 * `source` records the snap provenance: 'normalize' (canonical form),
 * 'fuzzy' (trigram snap), 'semantic' (label embedding), 'llm'
 * (ambiguous-band adjudication), 'user' (rename/merge). `score` keeps the
 * similarity that justified the rewrite.
 */
model MemoryTaxonomyAlias {
  id       String             @id @default(uuid())
  node     MemoryTaxonomyNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  nodeId   String
  /** Denormalized node scope (same values — powers the unique lookup). */
  lane     String   @db.VarChar(16)
  scopeKey String   @db.VarChar(255)
  kind     String   @db.VarChar(16)
  /** The normalized variant label that resolves to the node. */
  alias    String   @db.VarChar(120)
  source   String   @db.VarChar(16)
  score    Float?
  createdAt DateTime @default(now())

  @@unique([lane, scopeKey, kind, alias])
  @@index([nodeId])
  @@map("memory_taxonomy_alias")
}
