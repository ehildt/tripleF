# nginx entrypoint for the all-in-one Railway image.
# SPA lives under /dashboard/ (vite base), API and socket.io proxy to the
# NestJS server on 127.0.0.1:3000. ${NGINX_PORT} is substituted by the
# container entrypoint (Railway's public $PORT, else 80).
#
# All other $variables in this file are nginx-native and must NOT be
# envsubst-substituted — the entrypoint substitutes only ${NGINX_PORT}.

map $http_upgrade $connection_upgrade {
  default upgrade;
  ''      close;
}

server {
  listen ${NGINX_PORT};
  server_name _;

  root /usr/share/nginx/html;

  location = / {
    return 302 /dashboard/;
  }

  location = /dashboard {
    return 302 /dashboard/;
  }

  location /dashboard/ {
    try_files $uri $uri/ /dashboard/index.html;
  }

  location /api/ {
    client_max_body_size 100m;
    proxy_pass http://127.0.0.1:3000;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location /socket.io/ {
    proxy_pass http://127.0.0.1:3000;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header Host $host;
  }

  location = /healthz {
    proxy_pass http://127.0.0.1:3000/api/v1/health/live;
    proxy_set_header Host $host;
  }
}
