# syntax=docker/dockerfile:1

# Dedicated all-in-one Railway image for the test environment:
#   dashboard (static SPA) + server (NestJS) + PostgreSQL + KeyDB + MinIO
#   behind a single nginx entrypoint, supervised by supervisord.
# Credentials and env defaults mirror infra.compose.yml — no secrets here
# (test environment). Build from the repo root:
#   docker build -f railway/Dockerfile.railway .
# Railway picks this file up via config-as-code (railway/railway.toml) or
# the RAILWAY_DOCKERFILE_PATH=railway/Dockerfile.railway service variable.

FROM node:24 AS base
ENV CI=true \
    PNPM_ENABLE_PROGRESS_BAR=false \
    PNPM_CONFIG_CONFIRM_MODULES_PURGE=false \
    PNPM_CONFIG_MINIMUM_RELEASE_AGE=0 \
    HUSKY=0 \
    PNPM_HOME="/pnpm" \
    pnpm_config_store_dir="/repo/.pnpm-store"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable
WORKDIR /repo

# Stage: deps (workspace install, shared by both build stages)
FROM base AS deps
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY server/package.json server/
COPY server/prisma server/prisma
COPY dashboard/package.json dashboard/
RUN pnpm install --frozen-lockfile

# Stage: buildserver (compile for the prod runtime)
# NOTE: keep the copied file set minimal — stray root-level .ts files shift
# tsc's computed rootDir and would nest the output into dist/src/.
FROM deps AS buildserver
COPY server/tsconfig*.json server/shims.d.ts server/
COPY server/src server/src
RUN pnpm --filter "{server}" run build:prod \
    && pnpm deploy --legacy --filter "{server}" --prod /prod/server

# Stage: builddashboard (compile static assets; same-origin relative API
# URLs are intentional — nginx proxies /api and /socket.io to the server)
FROM deps AS builddashboard
COPY dashboard/ dashboard/
RUN pnpm --filter "{dashboard}" run build

# Stages: runtime dependencies fetched from the same images the local
# infra stack runs, so behavior matches infra.compose.yml.
FROM eqalpha/keydb:latest AS keydb
FROM minio/minio:latest AS minio

# Stage: runtime (single process tree under supervisord)
FROM node:24 AS runtime
ENV NODE_ENV=production \
    CI=true \
    PNPM_CONFIG_CONFIRM_MODULES_PURGE=false \
    PNPM_CONFIG_VERIFY_DEPS_BEFORE_RUN=false

# gettext-base provides envsubst; libatomic1 satisfies keydb-server's
# runtime deps; prisma CLI runs `db push` at boot (schema-only sync — the
# repo carries no migrations).
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        gettext-base \
        libbz2-1.0 \
        libcurl4 \
        liblz4-1 \
        libsnappy1v5 \
        libzstd1 \
        nginx \
        postgresql \
        supervisor \
    && rm -rf /var/lib/apt/lists/* \
    && corepack enable \
    && corepack prepare pnpm@11.17.0 --activate \
    && npm install -g prisma@7.9.1 dotenv-cli

COPY --from=keydb /usr/local/bin/keydb-server /usr/local/bin/keydb-server
# keydb-server links against OpenSSL 1.1 (its base image is an older
# Debian); carry those shared libs over so it runs on the runtime base.
COPY --from=keydb /usr/lib/x86_64-linux-gnu/libssl.so.1.1 /usr/lib/x86_64-linux-gnu/
COPY --from=keydb /usr/lib/x86_64-linux-gnu/libcrypto.so.1.1 /usr/lib/x86_64-linux-gnu/
COPY --from=minio /usr/bin/minio /usr/local/bin/minio
COPY server/keydb.conf /etc/keydb/keydb.conf
RUN printf '\ndir /data/keydb\n' >> /etc/keydb/keydb.conf

WORKDIR /app/server
COPY --from=buildserver /prod/server ./
COPY --from=buildserver /repo/server/dist ./dist
COPY --from=deps /repo/server/prisma ./prisma
COPY railway/prisma.config.mjs ./prisma.config.mjs

WORKDIR /app
COPY --from=builddashboard /repo/dashboard/dist/ /usr/share/nginx/html/dashboard/
COPY railway/docker-entrypoint.sh railway/start-server.sh /app/railway/
COPY railway/supervisord.conf /etc/supervisor/conf.d/stack.conf
COPY railway/nginx.conf.template /etc/nginx/templates/app.conf.template
RUN chmod +x /app/railway/*.sh \
    && mkdir -p /data/keydb /data/minio \
    && rm -f /etc/nginx/sites-enabled/default

EXPOSE 80
ENTRYPOINT ["/app/railway/docker-entrypoint.sh"]
