{
  "name": "@triplef.io/dashboard",
  "description": "tripleF (3F) dashboard — the Vue 3 workbench UI for the 3F harness: chat, system control, dead-letter replay, image preprocessing.",
  "version": "0.3.1",
  "type": "module",
  "license": "MIT",
  "author": {
    "email": "eugen.hildt@gmail.com",
    "name": "Eugen Hildt"
  },
  "bugs": {
    "email": "eugen.hildt@gmail.com"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "coverage": "vitest run --coverage",
    "depcheck": "npx depcheck .",
    "depcruise": "npx dependency-cruiser -c .depcruise.mjs --ts-config tsconfig.json src",
    "lint": "eslint ./src *.mjs",
    "lint-staged": "npx lint-staged --allow-empty",
    "ncu:update": "npx npm-check-updates -u --format group",
    "ncu:interactive": "npx npm-check-updates -u --interactive --format group",
    "ncu:validate": "npx npm-check-updates -e 2 --packageFile=./package.json",
    "lint:unused": "npx ts-unused-exports ./tsconfig.exclude.json --maxIssues=0",
    "format": "prettier --write .",
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006 --no-open",
    "storybook:build": "storybook build"
  },
  "dependencies": {
    "@headlessui/vue": "^1.7.23",
    "@lucide/vue": "^1.28.0",
    "@paralleldrive/cuid2": "^3.3.0",
    "@tanstack/vue-query": "^5.101.4",
    "@types/turndown": "^5.0.6",
    "@vueuse/core": "^14.4.0",
    "date-fns": "^4.4.0",
    "dompurify": "^3.4.12",
    "markdown-it": "^14.3.0",
    "p-wait-for": "^6.0.0",
    "partial-json": "^0.1.7",
    "pinia": "^3.0.4",
    "socket.io-client": "^4.8.3",
    "ts-unused-exports": "^11.0.1",
    "turndown": "^7.2.4",
    "vue": "^3.5.40"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.2.1",
    "@eslint/css": "^0.14.1",
    "@eslint/js": "^9.39.5",
    "@eslint/json": "^0.14.0",
    "@eslint/markdown": "^7.5.1",
    "@iconify/json": "^2.2.508",
    "@iconify/tailwind4": "^1.2.3",
    "@storybook/addon-a11y": "^10.5.5",
    "@storybook/addon-docs": "^10.5.5",
    "@storybook/addon-vitest": "^10.5.5",
    "@storybook/vue3-vite": "^10.5.5",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/vue": "^8.1.0",
    "@types/dompurify": "^3.2.0",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/browser-playwright": "4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "4.1.10",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "depcheck": "^1.4.7",
    "dependency-cruiser": "^17.4.3",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-sonarjs": "^3.0.7",
    "eslint-plugin-storybook": "^10.5.5",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^16.5.0",
    "jsdom": "^27.4.0",
    "lint-staged": "^16.4.0",
    "playwright": "^1.62.1",
    "postcss": "^8.5.25",
    "prettier": "^3.9.6",
    "storybook": "^10.5.5",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.10",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.9"
  }
}
