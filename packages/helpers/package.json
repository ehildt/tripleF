{
  "name": "@triplef/helpers",
  "description": "A shared utility library providing helper functions for the CKIR project.",
  "version": "1.5.2",
  "packageManager": "pnpm@11.23.0",
  "license": "MIT",
  "type": "module",
  "exports": {
    "./bootstrap": {
      "types": "./dist/bootstrap/index.d.ts",
      "import": "./dist/bootstrap/index.mjs"
    },
    "./find-up": {
      "types": "./dist/find-up/index.d.ts",
      "import": "./dist/find-up/index.mjs"
    },
    "./get-boolean-env": {
      "types": "./dist/get-boolean-env/index.d.ts",
      "import": "./dist/get-boolean-env/index.mjs"
    },
    "./get-byte-size-env": {
      "types": "./dist/get-byte-size-env/index.d.ts",
      "import": "./dist/get-byte-size-env/index.mjs"
    },
    "./get-number-env": {
      "types": "./dist/get-number-env/index.d.ts",
      "import": "./dist/get-number-env/index.mjs"
    },
    "./hash-payload": {
      "types": "./dist/hash-payload/index.d.ts",
      "import": "./dist/hash-payload/index.mjs"
    },
    "./is-buffer-or-serialized": {
      "types": "./dist/is-buffer-or-serialized/index.d.ts",
      "import": "./dist/is-buffer-or-serialized/index.mjs"
    },
    "./object-io": {
      "types": "./dist/object-io/index.d.ts",
      "import": "./dist/object-io/index.mjs"
    },
    "./text-to-lines": {
      "types": "./dist/text-to-lines/index.d.ts",
      "import": "./dist/text-to-lines/index.mjs"
    }
  },
  "main": "dist/bootstrap/index.mjs",
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ehildt/tripleF.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "author": {
    "email": "eugen.hildt@gmail.com",
    "name": "Eugen Hildt"
  },
  "bugs": {
    "email": "eugen.hildt@gmail.com"
  },
  "scripts": {
    "build": "pnpm tsup",
    "depcheck": "npx depcheck .",
    "depcruise": "npx dependency-cruiser -c .depcruise.mjs --ts-config tsconfig.json src",
    "format": "prettier --write .",
    "lint": "eslint ./src",
    "lint-staged": "npx lint-staged --allow-empty",
    "ncu:update": "npx npm-check-updates -u --format group",
    "ncu:interactive": "npx npm-check-updates -u --interactive --format group",
    "ncu:validate": "npx npm-check-updates -e 2 --packageFile=./package.json",
    "prebuild": "rimraf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "lint:unused": "npx ts-unused-exports ./tsconfig.exclude.json --maxIssues=6"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.1",
    "@eslint/js": "^10.0.1",
    "@types/eslint": "^9.6.1",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "4.1.11",
    "depcheck": "^1.4.7",
    "dependency-cruiser": "^18.2.0",
    "eslint": "^10.9.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-sonarjs": "^4.2.0",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "lint-staged": "^17.3.0",
    "npm-check-updates": "^23.0.2",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "ts-unused-exports": "^11.0.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.1.17",
    "@nestjs/swagger": "^11.3.0",
    "joi": "^18.0.2"
  }
}
