{
  "name": "@triplef/config-factory",
  "description": "A dynamic NestJS module factory designed to register, manage, and expose custom configuration providers throughout the application.",
  "version": "1.2.2",
  "packageManager": "pnpm@12.18.0",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    },
    "./cache-return-value": {
      "types": "./dist/cache-return-value/index.d.ts",
      "import": "./dist/cache-return-value/index.mjs"
    },
    "./config-factory": {
      "types": "./dist/config-factory/index.d.ts",
      "import": "./dist/config-factory/index.mjs"
    },
    "./validate-return-value": {
      "types": "./dist/validate-return-value/index.d.ts",
      "import": "./dist/validate-return-value/index.mjs"
    }
  },
  "main": "dist/index.mjs",
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ehildt/tripleF.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "author": {
    "email": "eugen.hildt@gmail.com",
    "name": "Eugen Hildt"
  },
  "bugs": {
    "email": "eugen.hildt@gmail.com"
  },
  "scripts": {
    "prepare": "husky",
    "build": "pnpm tsup",
    "depcheck": "npx depcheck .",
    "depcruise": "npx dependency-cruiser -c .depcruise.mjs --ts-config tsconfig.json src",
    "format": "prettier --write .",
    "lint": "eslint ./src",
    "lint-staged": "npx lint-staged --allow-empty",
    "ncu:update": "npx npm-check-updates -u --format group --dep prod,dev,optional,packageManager,peer",
    "ncu:interactive": "npx npm-check-updates -u --interactive --format group",
    "ncu:validate": "npx npm-check-updates -e 2 --packageFile=./package.json",
    "prebuild": "rimraf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "lint:unused": "npx ts-unused-exports ./tsconfig.exclude.json --maxIssues=6"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@types/eslint": "^9.6.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "5.1.0",
    "depcheck": "^1.4.7",
    "dependency-cruiser": "^18.7.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-sonarjs": "^4.2.2",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "lint-staged": "^17.6.0",
    "npm-check-updates": "^23.1.1",
    "prettier": "^3.9.10",
    "rimraf": "^6.1.4",
    "ts-unused-exports": "^11.0.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  },
  "peerDependencies": {
    "@triplef/helpers": "^1.6.3",
    "@nestjs/common": "^12.3.3",
    "zod": "^4.6.7"
  }
}
