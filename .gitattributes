# Normalize line endings
* text=auto

# Source files: LF, UTF-8
*.ts        text eol=lf
*.tsx       text eol=lf
*.vue       text eol=lf
*.js        text eol=lf
*.mjs       text eol=lf
*.cjs       text eol=lf
*.json      text eol=lf
*.md        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.css       text eol=lf
*.scss      text eol=lf
*.html      text eol=lf
*.prisma    text eol=lf

# Binary assets
banner.gif  binary
*.png       binary
*.jpg       binary
*.jpeg      binary
*.webp      binary
*.ico       binary

# Linguist overrides
.wiki/**    linguist-documentation
