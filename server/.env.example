# Base
PORT=3000
ADDRESS=0.0.0.0
NODE_ENV=local
PRINT_CONFIG=true
ENABLE_SWAGGER=true
BODY_LIMIT=104857600
LOG_LEVEL=log,warn,error # comma separated 'warn' | 'error' | 'debug' | 'log' | 'verbose' | 'fatal'

# Health
HEALTH_MEMORY_HEAP=512MB
HEALTH_MEMORY_RSS=768MB
HEALTH_DISK_PATH=/
HEALTH_DISK_THRESHOLD=0.8

# Cors
CORS_ORIGIN=*
CORS_METHODS=GET,HEAD,OPTIONS,PUT,PATCH,POST,DELETE
CORS_PREFLIGHT_CONTINUE=false
CORS_OPTIONS_SUCCESS_STATUS=204
CORS_CREDENTIALS=true
CORS_ALLOWED_HEADERS=Content-Type,Accept,x-harness-llm

# Socket.IO
SOCKET_IO_CONNECT_TIMEOUT=45000
SOCKET_IO_MAX_HTTP_BUFFER_SIZE=262144
SOCKET_IO_CLEANUP_EMPTY_CHILD_NAMESPACES=false
SOCKET_IO_TRANSPORTS=websocket,polling,webtransport
SOCKET_IO_CORS_ORIGIN=*
SOCKET_IO_CORS_CREDENTIALS=true
SOCKET_IO_CORS_METHODS=GET,POST
SOCKET_IO_PING_INTERVAL=25000
SOCKET_IO_PING_TIMEOUT=5000
SOCKET_IO_ALLOW_EIO3=false

# BullMQ Connection
BULLMQ_HOST=keydb
BULLMQ_PORT=6379
BULLMQ_USER=default
BULLMQ_PASS=redis
BULLMQ_CONNECT_TIMEOUT=30000
BULLMQ_COMMAND_TIMEOUT=30000

# BullMQ TLS (Optional)
BULLMQ_USE_TLS=false
BULLMQ_TLS_REJECT_UNAUTHORIZED=true
BULLMQ_PASSPHRASE=test
BULLMQ_TLS_CA=
BULLMQ_TLS_CERT=
BULLMQ_TLS_KEY=

# BullMQ Job Options
BULLMQ_JOB_DELAY=0
BULLMQ_JOB_LIFO=false
BULLMQ_JOB_PRIORITY=0
BULLMQ_JOB_ATTEMPTS=3
BULLMQ_JOB_STACK_TRACE_LIMIT=3
BULLMQ_WORKER_CONCURRENCY=3

# BullMQ Backoff
BULLMQ_BACKOFF_TYPE=exponential
BULLMQ_BACKOFF_DELAY=5270

# BullMQ Logger
BULLMQ_LOG_LEVEL=info
BULLMQ_LOG_BASE=
BULLMQ_LOG_TIMESTAMP_ENABLED=true
BULLMQ_LOG_TRANSPORT_TARGET=pino-pretty
BULLMQ_LOG_TRANSPORT_TRANSLATE_TIME=yyyy-mm-dd HH:MM:ss.l
BULLMQ_LOG_TRANSPORT_COLORIZE=true
BULLMQ_LOG_TRANSPORT_IGNORE=pid,hostname

# Ollama
OLLAMA_HOST=http://ollama:11434/api # https://ollama.com
OLLAMA_KEEP_ALIVE=15m
# OLLAMA_API_KEY=29479ae16f1c4c67ac936c..

# Ollama request timeouts (milliseconds)
# OLLAMA_STREAM_CHUNK_TIMEOUT_MS=60000   # abort streaming if no chunk arrives for 60s
# OLLAMA_STREAM_TOTAL_TIMEOUT_MS=600000  # max total time for a streaming response (10m)
# OLLAMA_GENERATE_TOTAL_TIMEOUT_MS=300000  # max total time for non-streaming calls (5m)
# OLLAMA_ENABLE_SMOOTH_STREAM=true         # word-level smooth streaming; set false to disable

# Postgres
POSTGRES_URL=postgres://visions:visions@postgres:5432/visions?sslmode=disable
# POSTGRES_USER=visions
# POSTGRES_PASSWORD=visions
# POSTGRES_DB=visions

# SearXNG / search metasearch URL (optional — enables general web search in AI tools)
SEARCH_URL=http://searxng:8080
SEARXNG_ENABLED=true
SEARXNG_RESULTS=10

# Brave Search API
BRAVE_API_KEY=
BRAVE_WEB_ENABLED=true
BRAVE_WEB_RESULTS=3
BRAVE_IMAGES_ENABLED=true
BRAVE_IMAGES_RESULTS=6
BRAVE_NEWS_ENABLED=true
BRAVE_NEWS_RESULTS=3
BRAVE_VIDEO_ENABLED=true
BRAVE_VIDEO_RESULTS=6

# Serper.dev API — per-endpoint enable/disable + result counts
SERPER_API_KEY=
SERPER_WEB_ENABLED=true
SERPER_WEB_RESULTS=3
SERPER_IMAGES_ENABLED=true
SERPER_IMAGES_RESULTS=6
SERPER_NEWS_ENABLED=true
SERPER_NEWS_RESULTS=3
SERPER_PLACES_ENABLED=false
SERPER_PLACES_RESULTS=5
SERPER_SHOPPING_ENABLED=false
SERPER_SHOPPING_RESULTS=5
SERPER_REVIEWS_ENABLED=false
SERPER_REVIEWS_RESULTS=5
SERPER_VIDEOS_ENABLED=true
SERPER_VIDEOS_RESULTS=6
SERPER_WEBPAGE_FETCH_ENABLED=true

# Browser Base Search
BROWSER_BASE_API_KEY=
BROWSER_PROJECT_ID=
BROWSER_BASE_ENABLED=false
BROWSER_BASE_RESULTS=10

# Browser Base Fetch
BROWSER_BASE_FETCH_ENABLED=false
BROWSER_BASE_FETCH_FORMAT=markdown
BROWSER_BASE_FETCH_PROXIES=false

NUM_CTX='131072,262144,524288,1048576,2097152'

# Image Preprocessing Defaults
PPROC_ENABLED=false
PPROC_RESIZE_MAX_WIDTH=768
PPROC_RESIZE_MAX_HEIGHT=
PPROC_RESIZE_WITHOUT_ENLARGEMENT=true
PPROC_VARIANT_ORIGINAL=true
PPROC_VARIANT_GRAYSCALE=true
PPROC_VARIANT_DENOISED=true
PPROC_VARIANT_SHARPENED=false
PPROC_VARIANT_CLAHE=true
PPROC_BLUR_SIGMA=0.5
PPROC_SHARPEN_SIGMA=1
PPROC_SHARPEN_M1=1
PPROC_SHARPEN_M2=2
PPROC_CONTRAST_LEVEL=1.3
PPROC_BRIGHTNESS_LEVEL=1.2
PPROC_CLAHE_WIDTH=8
PPROC_CLAHE_HEIGHT=8
PPROC_CLAHE_MAX_SLOPE=3
PPROC_NORMALIZE_LOWER=1
PPROC_NORMALIZE_UPPER=99

# MinIO
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=failed-jobs

# Failed job lifecycle
FAILED_JOB_RETRY_DELAY_MS=300000
FAILED_JOB_REINSTATE_BATCH_SIZE=10

# Per-stage retention: keep N most-recent jobs per status before aging kicks in
DLQ_FAILED_RETAIN=100
DLQ_CLEARED_RETAIN=5
DLQ_REMOVED_RETAIN=0

# Per-stage aging: jobs older than this (ms) get promoted to the next stage
# Failed → Cleared (was reinstated but failed again, or aged out untouched)
# Cleared → Removed (was successful, now aged out)
# Removed → Hard Delete (permanent removal)
DLQ_FAILED_AGE_MS=86400000
DLQ_CLEARED_AGE_MS=86400000
DLQ_REMOVED_AGE_MS=86400000