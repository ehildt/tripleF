generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum DlqStatus {
  Failed
  Active
  Cleared
  Removed
}

model HarnessDlq {
  requestId      String    @id @db.VarChar(255)
  queueName      String    @db.VarChar(100)
  jobId          String?   @db.VarChar(255)
  status         DlqStatus @default(Failed)
  payload        Json      @default(dbgenerated())
  retryConfig    Json?
  failedReason   String?
  failedAt       DateTime?
  attemptsMade   Int       @default(1)
  totalAttempts  Int       @default(1)
  failureHistory Json?
  nextRetryAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now()) @updatedAt

  @@map("harness_dlq")
}

model HarnessConversation {
  sessionId      String   @db.VarChar(255)
  conversationId String   @db.VarChar(255)
  requestId      String   @db.VarChar(255)
  title          String?  @db.VarChar(500)
  content        Json     @default(dbgenerated())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt

  @@id([sessionId, conversationId, requestId])
  @@index([sessionId, conversationId])
  @@map("harness_conversation")
}

model HarnessConfig {
  sessionId         String   @id @db.VarChar(255)
  selectedModel     String?  @db.VarChar(255)
  preprocessing     Json?
  providerOverrides Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now()) @updatedAt

  @@map("harness_config")
}

model HarnessProviderOverride {
  provider  String   @id @db.VarChar(100)
  values    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@map("harness_provider_override")
}
